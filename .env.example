# Ekomun созламалари. Нусха олинг:  cp .env.example .env  ва қийматларни ёзинг.
# .env файлини ҳеч қачон GitHub'га юкламанг (у .gitignore да).

# --- Мажбурий ---
# Бошқарув маркази пароли: камида 12 белги, ҳарф + рақам + белги
ADMIN_PASSWORD=

# --- Бошқарув марказини яшириш ва ҳимоялаш (тавсия этилади) ---
# Махфий манзил: https://сайт/boshqaruv-7k2q/   (асл қиймат /admin)
ADMIN_PATH=/boshqaruv-7k2q
# Икки босқичли ҳимоя: node tools/admin-totp.js чиқарган калит (бўш қолса — фақат парол)
ADMIN_TOTP_SECRET=
# Алоҳида домен, масалан admin.ekomun.uz. Берилса, админ фақат шу доменда очилади
ADMIN_HOST=
# Фақат шу IP лардан очилсин (вергул билан), бўш — ҳамма жойдан
ADMIN_ALLOW_IPS=

# --- Сервер ---
PORT=3000
# Ҳисоб калити (eko_pass) шифри: тасодифий узун матн, масалан  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Бўш қолса ADMIN_PASSWORD дан ҳосил қилинади. Ўзгартирилса, браузерлардаги эски калитлар бекор бўлади.
ACCOUNT_SECRET=
# Маълумотлар папкаси (Docker'да /data, VPS'да масалан /var/lib/ekomun)
DATA_DIR=./data
# Сайт прокси ортида бўлса (Render, Railway, Caddy, Nginx) — 1.
# Сервер интернетга тўғридан-тўғри очиқ бўлса — 0 (акс ҳолда IP ни сохталаштириш мумкин)
TRUST_PROXY=0
# Нечта кунлик захира нусха сақлансин
BACKUP_KEEP=14
# Статистика вақт минтақаси, дақиқада (300 = Тошкент)
STATS_TZ_MINUTES=300

# --- Ихтиёрий ---
# Бошқарув марказида IP бўйича ҳудудни (вилоят/шаҳар) кўрсатиш: ipwho (асл қиймат) ёки off
GEO_PROVIDER=ipwho
# Махфийлик сиёсатидаги алоқа почтаси
CONTACT_EMAIL=
# «Эко-кўз» (расм таҳлили) учун Claude API калити — махфий!
ANTHROPIC_API_KEY=
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=300
# Google Play (TWA) иловаси учун SHA-256 изи
ANDROID_PACKAGE=uz.ekotalim.app
ANDROID_SHA256=

# --- Docker Compose + Caddy (VPS) учун ---
# Сайт домени (A ёзуви серверингиз IP сига қараган бўлсин). Caddy HTTPS сертификатни ўзи олади
DOMAIN=ekomun.uz
# Caddy ишлатганда 127.0.0.1 қилинг: 3000-порт ташқаридан ёпилади, сайт фақат HTTPS орқали очилади
APP_BIND=0.0.0.0

# Open Badges 3.0 имзоси (ихтиёрий). Бўлмаса калит DATA_DIR/ob3-key.json да ўзи яратилади.
# Бир нечта серверда бир хил калит керак бўлса, Ed25519 махфий калитни JWK кўринишида беринг.
# OB3_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519","d":"...","x":"..."}
# Сертификатлардаги манзил (ихтиёрий; бўлмаса сўровдаги домен олинади)
# PUBLIC_URL=https://ekomun.onrender.com

# --- PRO обуна ва тўловлар (pro.js) ---
# Нархлар, сўмда (даромад режаси: 25 000 / ой, 199 000 / йил)
PRO_PRICE_MONTH=25000
PRO_PRICE_YEAR=199000
# Синов режими: Payme тест кассаси + «🧪 Синов тўлови» тугмаси (ҳақиқий пулсиз). Ишлаб чиқаришда 0!
PAY_SANDBOX=0
# Payme Business: кабинетдаги Merchant ID ва калит (махфий!). Тест учун PAYME_TEST_KEY
# Payme кабинетида Endpoint URL: https://сайт/api/pay/payme ; ҳисоб майдони: order_id
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# Фискал чек (ОФД) учун ИКПУ (МХИК) коди ва қадоқ коди (Payme кабинетида фискаллаштириш ёқилса)
PAYME_IKPU=
PAYME_PACKAGE_CODE=
# Click: Service ID, Merchant ID ва Secret key (махфий!)
# Click кабинетида Prepare URL: https://сайт/api/pay/click/prepare ; Complete URL: https://сайт/api/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Шартнома ҳали йўқ бўлса — қўлда тасдиқлаш: карта/ҳисоб реквизити. Фойдаланувчи чек юборади, админ тасдиқлайди
# Масалан: PAY_MANUAL_INFO=Humo 9860 0000 0000 0000 · Эгамбердиев Ш.
PAY_MANUAL_INFO=
# Шахсий AI агент: бир PRO фойдаланувчига ойига нечта савол (асл 60)
AGENT_MONTHLY_LIMIT=60
# PRO да Эко-кўз кунлик чеклови (оддийда AI_USER_DAILY_LIMIT)
AI_PRO_DAILY_LIMIT=30
